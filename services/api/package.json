{
  "name": "@dvqb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "node ../../scripts/build/clean-api.mjs && tsc -p tsconfig.json && node ../../scripts/build/api.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/database/cli.ts seed",
    "db:replace-catalog": "node --env-file-if-exists=.env --import tsx src/database/cli.ts replace-catalog",
    "test:coverage": "c8 --all --src src --include \"src/**/*.ts\" --reporter=text --reporter=json --reporter=json-summary --reporter=lcov --reporter=html --reports-dir ../../coverage/api node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=../../test-results/api/junit.xml test/unit/*.test.ts test/integration/*.test.ts && node ../../scripts/test/coverage-gate.mjs src ../../coverage/api/coverage-final.json",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('../../test-results/api', {recursive:true})\"",
    "db:demo-partners": "node --env-file-if-exists=.env --import tsx src/database/demo-partners.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-roll": "4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "12.0.0",
    "tsx": "4.23.15"
  }
}
