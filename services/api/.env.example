NODE_ENV=development
DATABASE_URL=postgresql://dvqb:local-only-password@127.0.0.1:55432/dvqb_local
PORT=3100
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:8081
# Local example only. Generate a private value before using beyond local/test.
CURSOR_SECRET=local-example-cursor-key-change-before-sharing
# Enables the local email/password slice. Use a separate random private value.
AUTH_SECRET=local-example-auth-key-change-before-sharing

# Local MAP-01 pilot only. Empty disables address lookup; never commit a real key.
GEOAPIFY_API_KEY=

# P0-3 DEMO/test only; both required to enable result photos. Never production.
# Use a device-reachable API origin (Android emulator: http://10.0.2.2:3100).
LOCAL_ASSET_DIRECTORY=../../.local/assets
LOCAL_ASSET_ORIGIN=http://127.0.0.1:3100

# P1-01: disabled by default. Only an isolated dvqb_p1_demo/dvqb_test on loopback.
# Do not enable on dvqb_local or a production database.
# LOCAL_MESSAGES=1
# LOCAL_MESSAGES_SECRET=<generate a separate random secret of at least 32 characters>
# LOCAL_MAILPIT_URL=http://127.0.0.1:8025
# LOCAL_SMS_DIRECTORY=/absolute/local/path/sms-demo
# LOCAL_MESSAGE_CONTACTS=owner@example.test,worker@example.test,+84900000001
