{
  "expo": {
    "name": "Dịch vụ quanh bạn",
    "slug": "dich-vu-quanh-ban",
    "version": "0.1.0",
    "scheme": "dvqb",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.dichvuquanhban.app",
      "infoPlist": {
        "RCTNewArchEnabled": true
      }
    },
    "android": {
      "package": "vn.dichvuquanhban.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "./plugins/with-debug-http.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép lấy vị trí khi bạn bấm Dùng vị trí hiện tại.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chọn ảnh kết quả công việc để gửi cùng hóa đơn.",
          "cameraPermission": false,
          "microphonePermission": "Cho phép dùng micro khi bạn bắt đầu hoặc nhận cuộc gọi."
        }
      ],
      "expo-notifications",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Cho phép dùng micro khi bạn bắt đầu hoặc nhận cuộc gọi."
        }
      ],
      "./plugins/with-call-audio-only.cjs"
    ],
    "extra": {
      "eas": {
        "projectId": "128de9c8-0139-449b-9b0e-51b3fa203fdf"
      }
    },
    "owner": "anhthai010702"
  }
}
