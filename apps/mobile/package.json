{
  "name": "@dvqb/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform all"
  },
  "dependencies": {
    "expo": "57.0.25",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx",
      "**/*.test.ts"
    ]
  }
}
