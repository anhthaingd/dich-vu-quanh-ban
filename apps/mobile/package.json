{
  "name": "@dvqb/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform all",
    "test:coverage": "jest --runInBand --coverage && node ../../scripts/test/coverage-gate.mjs src ../../coverage/mobile/coverage-final.json"
  },
  "dependencies": {
    "expo": "57.0.25",
    "expo-crypto": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "jest-junit": "17.0.0",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx",
      "**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/helpers/setup.ts"
    ],
    "collectCoverageFrom": [
      "index.ts",
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "../../coverage/mobile",
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "lcov",
      "html"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "../../test-results/mobile",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
