{
  "name": "@dvqb/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --localhost",
    "android": "EXPO_PUBLIC_API_URL=http://10.0.2.2:3100/v1 expo run:android --device",
    "ios": "EXPO_PUBLIC_API_URL=http://127.0.0.1:3100/v1 expo run:ios --device",
    "start:android": "EXPO_PUBLIC_API_URL=http://10.0.2.2:3100/v1 node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --dev-client --localhost --android",
    "start:ios": "EXPO_PUBLIC_API_URL=http://127.0.0.1:3100/v1 node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --dev-client --localhost --ios",
    "native:generate": "expo prebuild --no-install",
    "web": "node --dns-result-order=ipv4first ../../node_modules/expo/bin/cli start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform all",
    "test:coverage": "jest --runInBand --coverage && node ../../scripts/test/coverage-gate.mjs src ../../coverage/mobile/coverage-final.json"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "@livekit/react-native-webrtc": "150.1.0",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@types/geojson": "7946.0.16",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-location": "57.0.20",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "i18n-js": "4.5.3",
    "livekit-client": "2.23.0",
    "maplibre-gl": "5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@expo/plist": "0.8.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "expo-mcp": "0.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "jest-junit": "17.0.0",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx",
      "**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/helpers/setup.ts"
    ],
    "collectCoverageFrom": [
      "index.ts",
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "../../coverage/mobile",
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "lcov",
      "html"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "../../test-results/mobile",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
