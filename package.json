{
  "name": "dich-vu-quanh-ban",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "services/api"
  ],
  "engines": {
    "node": "24.7.0",
    "npm": "11.5.1"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "lint": "eslint apps/mobile services/api scripts tests",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w services/api",
    "build": "npm run build --workspaces",
    "api": "npm run dev -w services/api",
    "mobile": "npm run start -w apps/mobile --",
    "mobile:web": "npm run web -w apps/mobile --",
    "mobile:android": "npm run android -w apps/mobile --",
    "mobile:ios": "npm run ios -w apps/mobile --",
    "mobile:start:android": "npm run start:android -w apps/mobile --",
    "mobile:start:ios": "npm run start:ios -w apps/mobile --",
    "mobile:prebuild": "npm run native:generate -w apps/mobile --",
    "test:native-config": "node scripts/test/native-config.mjs",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait db",
    "db:stop": "docker compose -f infra/compose.yaml stop db",
    "db:migrate": "npm run db:migrate -w services/api",
    "db:seed": "npm run db:seed -w services/api",
    "test:smoke": "npm run build -w services/api && playwright test --config tests/e2e/web/playwright.config.mjs",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:tooling": "node --test scripts/test/*.test.mjs scripts/diagnostics/*.test.mjs",
    "logs:export": "node scripts/diagnostics/export.mjs",
    "api:pretty": "npm run api --silent | pino-pretty --messageKey message --timestampKey timestamp",
    "api:logs": "LOG_TO_FILE=1 npm run api",
    "test:unit": "npm test",
    "test:e2e": "npm run build -w services/api && playwright test --config tests/e2e/web/playwright.config.mjs",
    "test:load": "npm run build -w services/api && node tests/performance/catalog.mjs",
    "test:native": "npm run build -w services/api && node scripts/test/native.mjs",
    "db:demo-partners": "npm run db:demo-partners -w services/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
